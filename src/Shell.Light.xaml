<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeniZip" Width="1000" Height="650" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI" FontSize="13" Foreground="#20262C">
 <Window.Resources>
  <Style TargetType="Button" x:Key="Action">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#27333C"/><Setter Property="BorderBrush" Value="#D8DFE5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EEF5FC"/><Setter TargetName="Frame" Property="BorderBrush" Value="#B8CFE5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#DBEAF9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#3879B7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#2874B5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2874B5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1D619B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#174F80"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button" x:Key="Tool" BasedOn="{StaticResource Action}"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="6,7"/><Setter Property="MinWidth" Value="66"/><Setter Property="Margin" Value="2,1"/></Style>
  <Style TargetType="TextBox" x:Key="Input"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CDD6DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#3879B7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Menu"><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="4,1"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Padding" Value="8,4"/></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Height" Value="28"/><Setter Property="Background" Value="#FAFBFC"/><Setter Property="BorderBrush" Value="#E1E5E9"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Foreground" Value="#586875"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="Height" Value="27"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F6FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DCEBFB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#8FB9E1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="78"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="27"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Menu>
   <MenuItem Header="_File"><MenuItem x:Name="MenuOpen" Header="_Open archive…" InputGestureText="Ctrl+O"/><MenuItem x:Name="MenuOpenFolder" Header="Open _folder…"/><MenuItem x:Name="MenuCreate" Header="_Create archive…" InputGestureText="Ctrl+N"/><Separator/><MenuItem x:Name="MenuCloseArchive" Header="Close archive"/><MenuItem x:Name="MenuExit" Header="E_xit" InputGestureText="Alt+F4"/></MenuItem>
   <MenuItem Header="_Commands"><MenuItem x:Name="MenuAdd" Header="Add files…"/><MenuItem x:Name="MenuAddFolder" Header="Add folder…"/><MenuItem x:Name="MenuExtract" Header="Extract to…" InputGestureText="Alt+E"/><MenuItem x:Name="MenuExtractHere" Header="Extract here"/><Separator/><MenuItem x:Name="MenuTest" Header="Test archive" InputGestureText="Alt+T"/><MenuItem x:Name="MenuView" Header="View file" InputGestureText="Alt+V"/><MenuItem x:Name="MenuDelete" Header="Delete selected…"/></MenuItem>
   <MenuItem Header="_Tools"><MenuItem x:Name="MenuFind" Header="Find files" InputGestureText="Ctrl+F"/><MenuItem x:Name="MenuInfo" Header="Information"/></MenuItem>
   <MenuItem Header="F_avorites"><MenuItem x:Name="MenuRecent" Header="Recent archives"/><Separator/><MenuItem x:Name="MenuDownloads" Header="Downloads"/><MenuItem x:Name="MenuDesktop" Header="Desktop"/><MenuItem x:Name="MenuDocuments" Header="Documents"/></MenuItem>
   <MenuItem Header="_Options"><MenuItem x:Name="MenuDefaults" Header="Default archive app…"/><MenuItem x:Name="MenuUpdates" Header="Check for updates…"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem x:Name="MenuShortcuts" Header="Keyboard shortcuts"/><MenuItem x:Name="MenuAbout" Header="About BeniZip…"/></MenuItem>
  </Menu>
  <Border Grid.Row="1" BorderBrush="#E1E5E9" BorderThickness="0,1,0,1" Background="White" Padding="5,2">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="AddButton" Style="{StaticResource Tool}" ToolTip="Add files to an archive, or create a new archive"><StackPanel><Grid Width="29" Height="31"><Path Data="M3,8 L13,3 24,8 24,25 13,30 3,25 Z M3,8 L13,13 24,8 M13,13 L13,30" Stroke="#8764B0" StrokeThickness="1.7"/><Path Data="M21,0 L21,10 M16,5 L26,5" Stroke="#357BB0" StrokeThickness="1.8"/></Grid><TextBlock Text="Add" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="ExtractButton" Style="{StaticResource Tool}" MinWidth="80" ToolTip="Extract all or selected files"><StackPanel><Grid Width="32" Height="31"><Path Data="M2,9 L11,9 14,12 30,12 30,29 2,29 Z M2,9 L2,6 12,6 15,9 27,9 27,12" Stroke="#BC923D" StrokeThickness="1.7"/><Path Data="M16,0 L16,18 M11,13 L16,18 21,13" Stroke="#238A71" StrokeThickness="2"/></Grid><TextBlock Text="Extract To" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="TestButton" Style="{StaticResource Tool}" ToolTip="Check archive integrity"><StackPanel><Path Data="M14,1 L26,6 25,18 Q23,25 14,30 Q5,25 3,18 L2,6 Z M8,14 L13,19 21,10" Stroke="#3C946E" StrokeThickness="1.8" Width="30" Height="31" Stretch="Uniform"/><TextBlock Text="Test" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="PreviewButton" Style="{StaticResource Tool}" ToolTip="Preview a selected file"><StackPanel><Path Data="M5,1 L21,1 28,8 28,30 5,30 Z M21,1 L21,8 28,8 M9,15 Q16,7 24,15 Q16,23 9,15 M18,15 A2,2 0 1 1 14,15 A2,2 0 1 1 18,15" Stroke="#4F8FC0" StrokeThickness="1.6" Width="30" Height="31" Stretch="Uniform"/><TextBlock Text="View" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="DeleteButton" Style="{StaticResource Tool}" ToolTip="Delete selected members from the archive"><StackPanel><Path Data="M5,7 L25,7 M10,7 L10,2 20,2 20,7 M7,7 L9,29 21,29 23,7 M12,12 L13,24 M18,12 L17,24" Stroke="#B56B69" StrokeThickness="1.7" Width="30" Height="31" Stretch="Uniform"/><TextBlock Text="Delete" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Border Width="1" Height="46" Background="#E6EAED" Margin="7,0"/>
    <Button x:Name="FindButton" Style="{StaticResource Tool}" ToolTip="Find files · Ctrl+F"><StackPanel><Path Data="M22,11 A10,10 0 1 1 2,11 A10,10 0 1 1 22,11 M19,19 L29,29" Stroke="#5983A4" StrokeThickness="2" Width="30" Height="31" Stretch="Uniform"/><TextBlock Text="Find" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="InfoButton" Style="{StaticResource Tool}" ToolTip="Archive or selected-file information"><StackPanel><Path Data="M29,15 A14,14 0 1 1 1,15 A14,14 0 1 1 29,15 M15,12 L15,24 M15,6 L15,8" Stroke="#6D91AA" StrokeThickness="1.8" Width="30" Height="31" Stretch="Uniform"/><TextBlock Text="Info" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
    <Button x:Name="MoreButton" Style="{StaticResource Tool}" ToolTip="Additional archive actions"><StackPanel><Path Data="M4,15 L6,15 M14,15 L16,15 M24,15 L26,15" Stroke="#82939F" StrokeThickness="3" Width="30" Height="31"/><TextBlock Text="More" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12"/></StackPanel></Button>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2" Margin="6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
   <Button x:Name="UpButton" Style="{StaticResource Action}" Padding="6" BorderBrush="Transparent" ToolTip="Up one folder"><Path Data="M1,7 L7,1 13,7 M7,1 L7,14" Stroke="#6A8191" StrokeThickness="1.6" Width="14" Height="15"/></Button>
   <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource Input}" Padding="8,4" FontSize="12" ToolTip="Archive or folder path · Ctrl+L"/>
   <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource Action}" Padding="6" BorderBrush="Transparent" ToolTip="Refresh · F5"><Path Data="M13,5 A6,6 0 1 0 13,10 M13,0 L13,5 8,5" Stroke="#6A8191" StrokeThickness="1.5" Width="14" Height="15"/></Button>
   <Grid Grid.Column="3" Margin="8,0,0,0"><TextBox x:Name="SearchBox" Style="{StaticResource Input}" Padding="8,4" FontSize="12"/><TextBlock x:Name="SearchHint" Text="Search files" Foreground="#9BA7B0" FontSize="12" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
  </Grid>
  <Border Grid.Row="3" BorderBrush="#DDE3E8" BorderThickness="0,1" Background="White">
   <Grid>
    <ListView x:Name="FilesList" Background="White" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
     <ListView.View><GridView AllowsColumnReorder="True">
      <GridViewColumn Width="340" Header="Name"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="7,0"><Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}" Stretch="Uniform" Width="17" Height="18" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="294"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Width="112" Header="Size"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" FontSize="12" Margin="8,0" Foreground="#4D5D69"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Width="142" Header="Type"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Type}" FontSize="12" Margin="8,0" Foreground="#657783"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Width="160" Header="Modified"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Modified}" FontSize="12" Margin="8,0" Foreground="#657783"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Width="114" Header="Packed"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PackedText}" FontSize="12" Margin="8,0" Foreground="#657783"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     </GridView></ListView.View>
    </ListView>
    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock x:Name="EmptyTitle" Text="No files here" FontSize="17" Foreground="#7D8D99" HorizontalAlignment="Center"/><TextBlock Text="Open an archive, or drag one into this window." Foreground="#A3AFB8" FontSize="12" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#7A8995" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectionText" Grid.Column="1" FontSize="11" Foreground="#667783" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
  <Border x:Name="OperationPanel" Grid.Row="5" Background="White" Padding="12,7" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OperationText" FontSize="11" Foreground="#667783"/><ProgressBar x:Name="OperationProgress" Height="3" Margin="0,6,12,0" Foreground="#4C99CF" Background="#E8F0F7" BorderThickness="0" IsIndeterminate="True"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource Action}" Content="Cancel" Padding="8,4"/></Grid></Border>
 </Grid>
</Window>
